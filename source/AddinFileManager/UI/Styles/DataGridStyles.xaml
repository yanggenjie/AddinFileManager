<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  DataGrid默认需要设置的样式  -->
    <Style x:Key="DataGridDefault" BasedOn="{StaticResource MahApps.Styles.DataGrid.Azure}" TargetType="DataGrid">
        <Style.Setters>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
        </Style.Setters>
    </Style>

    <!-- 行样式 - 自定义选中颜色，适配分组结构 -->
    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <!-- 普通行状态 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F5F5F5"/>
            </Trigger>
            <!-- 选中行状态 - 浅蓝色背景 -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#E3F2FD"/>
                <Setter Property="BorderBrush" Value="#90CAF9"/>
            </Trigger>
            <!-- 选中且悬停 -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#BBDEFB"/>
            </MultiTrigger>
            <!-- Alternating行背景 -->
            <DataTrigger Binding="{Binding AlternationIndex, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="1">
                <Setter Property="Background" Value="#FAFAFA"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 单元格样式 - 选中时保持文字颜色 -->
    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <!-- 选中单元格 - 背景透明让行的背景色显示 -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>