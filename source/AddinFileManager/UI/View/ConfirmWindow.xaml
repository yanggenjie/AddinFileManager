<Window x:Class="AddinFileManager.UI.View.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Confirm" MinHeight="180" MinWidth="380" MaxHeight="500" MaxWidth="600" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Topmost="True">
    <Border Background="White" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            
            <Border Background="#F8F8F8" CornerRadius="6,6,0,0" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <TextBlock x:Name="TitleTextBlock" Text="提示" FontWeight="SemiBold" FontSize="14" Margin="15,0,0,0" Foreground="#333333" VerticalAlignment="Center"/>
            </Border>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,10">
                <TextBlock x:Name="MessageTextBlock" Text="确定要执行此操作吗？" TextWrapping="Wrap" FontSize="14" Foreground="#444444" VerticalAlignment="Center"/>
            </ScrollViewer>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center">
                <Button x:Name="CancelButton" Content="取消" Width="75" Height="32" Margin="0,0,10,0" Click="CancelButton_Click" Background="White" Foreground="#333333" BorderBrush="#CCCCCC" Cursor="Hand" mah:ControlsHelper.CornerRadius="4"/>
                <Button x:Name="ConfirmButton" Content="确定" Width="75" Height="32" Click="ConfirmButton_Click" Background="#E51400" Foreground="White" BorderThickness="0" Cursor="Hand" mah:ControlsHelper.CornerRadius="4"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>