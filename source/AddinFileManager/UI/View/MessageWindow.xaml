<Window x:Class="AddinFileManager.UI.View.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="提示" MinHeight="140" MinWidth="320" MaxHeight="400" MaxWidth="500" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Topmost="True">
    <Border Background="White" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="15" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBorder" Background="#F8F8F8" CornerRadius="6,6,0,0" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IconTextBlock" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" Foreground="#E51400"/>
                    <TextBlock x:Name="TitleTextBlock" Text="提示" FontWeight="SemiBold" FontSize="14" Foreground="#333333"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,15">
                <TextBlock x:Name="MessageTextBlock" Text="消息内容" TextWrapping="Wrap" FontSize="14" Foreground="#444444" VerticalAlignment="Center"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" VerticalAlignment="Center">
                <Button x:Name="OkButton" Content="确定" Width="80" Height="32" Click="OkButton_Click" Background="#E51400" Foreground="White" BorderThickness="0" Cursor="Hand" mah:ControlsHelper.CornerRadius="4"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
