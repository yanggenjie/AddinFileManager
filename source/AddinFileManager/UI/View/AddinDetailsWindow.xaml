<Window x:Class="AddinFileManager.UI.View.AddinDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="插件详情" Height="400" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" FontSize="14">
    <Window.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxHeight" Value="60"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题区域 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="40" Height="40" CornerRadius="8" Background="#E3F2FD" Margin="0,0,15,0">
                    <iconPacks:PackIconMaterial Kind="ApplicationCogOutline"
                                                Width="20" Height="20"
                                                Foreground="#1976D2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleName" Text="插件名称" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#333"/>
            </StackPanel>

            <!-- 信息区域 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 基本信息 -->
                    <TextBlock Text="基本信息" FontSize="14" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="文件名:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="FileNameText" Grid.Column="1" Style="{StaticResource InfoValue}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="安装位置:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="LocationText" Grid.Column="1" Style="{StaticResource InfoValue}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="状态:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Style="{StaticResource InfoValue}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="完整路径:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="FullPathText" Grid.Column="1" Style="{StaticResource InfoValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>

                    <Separator Margin="0,15,0,15" Background="#E0E0E0"/>

                    <!-- 插件详情 -->
                    <TextBlock Text="插件信息" FontSize="14" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名称:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="NameText" Grid.Column="1" Style="{StaticResource InfoValue}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="类型:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="TypeText" Grid.Column="1" Style="{StaticResource InfoValue}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="程序集:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="AssemblyText" Grid.Column="1" Style="{StaticResource InfoValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="类名:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ClassNameText" Grid.Column="1" Style="{StaticResource InfoValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="供应商ID:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="VendorIdText" Grid.Column="1" Style="{StaticResource InfoValue}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="供应商描述:" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="VendorDescText" Grid.Column="1" Style="{StaticResource InfoValue}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="打开目录" Width="90" Height="32" Margin="0,0,10,0"
                        Click="OpenFolder_Click" Cursor="Hand"
                        mah:ControlsHelper.CornerRadius="4"/>
                <Button Content="关闭" Width="90" Height="32"
                        Click="Close_Click" Background="#1976D2" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        mah:ControlsHelper.CornerRadius="4"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>