<Window x:Class="AddinFileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AddinFileManager.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AddinFileManager"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Revit插件管理器" Width="1150" Height="700"
        WindowStartupLocation="CenterScreen" mc:Ignorable="d"
        KeyDown="MainWindow_KeyDown"
        Background="{DynamicResource MahApps.Brushes.Control.Background}">

    <Window.Resources>
        <!-- 转换器 -->
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

        <!-- 圆角按钮样式 -->
        <Style x:Key="RoundedButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 删除按钮样式 -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray6}"/>
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE51400"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 版本列表项样式 -->
        <Style x:Key="VersionListItem" TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <!-- 插件数量徽章 -->
                                <Border x:Name="CountBadge"
                                        Grid.Column="1"
                                        Background="{DynamicResource MahApps.Brushes.Accent}"
                                        CornerRadius="10"
                                        Padding="6,2"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding Count, Converter={StaticResource IntToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Count}" Foreground="{DynamicResource MahApps.Brushes.IdealForeground}" FontSize="11" FontWeight="Medium"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.IdealForeground}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent2}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 空数据提示模板 -->
        <ControlTemplate x:Key="EmptyDataTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0">
                <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource MahApps.Brushes.Gray9}" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ApplicationCogOutline" Width="36" Height="36"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                </Border>
                <TextBlock Text="未找到插件" FontSize="20" FontWeight="Medium" Margin="0,20,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                <TextBlock Text="当前 Revit 版本目录下没有第三方插件" FontSize="14" Margin="0,10,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray3}"/>
                <TextBlock Text="您可以尝试选择其他版本或检查安装目录" FontSize="13" Margin="0,5,0,0"
                           HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray5}"/>
            </StackPanel>
        </ControlTemplate>

        <!-- ToggleSwitch 居中样式 -->
        <Style x:Key="CenteredToggleSwitch" TargetType="mah:ToggleSwitch" BasedOn="{StaticResource MahApps.Styles.ToggleSwitch}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}"/>
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左侧版本列表区域 -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 设置按钮 -->
            <Button Grid.Row="0" Style="{StaticResource RoundedButton}"
                    Margin="0,0,0,10" Padding="12,8"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CogOutline" Width="16" Height="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                    <TextBlock Text="设置" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 主题切换按钮 -->
            <Button Grid.Row="1" Style="{StaticResource RoundedButton}"
                    Margin="0,0,0,15" Padding="12,8"
                    Command="{Binding ThemeToggleCommand}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ThemeLightDark" Width="16" Height="16" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                    <TextBlock Text="切换主题" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 版本列表 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource MahApps.Brushes.Border.NonActive}" BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding RevitVersionItems}"
                         SelectedValuePath="Version"
                         SelectedValue="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ItemContainerStyle="{StaticResource VersionListItem}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Version}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- 右侧顶部工具栏 -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索框 -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="搜索插件..."
                     mah:TextBoxHelper.ClearTextButton="True"
                     VerticalAlignment="Center"
                     Padding="8,6"
                     TextChanged="SearchBox_TextChanged"/>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="批量启用" Margin="0,0,8,0" Padding="15,6"
                        Command="{Binding BatchEnableCommand}"/>
                <Button Content="批量禁用" Margin="0,0,8,0" Padding="15,6"
                        Command="{Binding BatchDisableCommand}"/>
                <Button Content="批量删除" Style="{StaticResource DeleteButton}" Margin="0,0,8,0" Padding="15,6"
                        Command="{Binding BatchDeleteCommand}"/>
                <Button ToolTip="刷新 (F5)" Margin="0,0,8,0" Padding="10,6"
                        Command="{Binding RefreshCommand}">
                    <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16"/>
                </Button>
                <Button ToolTip="撤销 (Ctrl+Z)" Padding="10,6"
                        Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}">
                    <iconPacks:PackIconMaterial Kind="Undo" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 右侧 DataGrid 区域 -->
        <Grid Grid.Row="1" Grid.Column="1">
            <DataGrid x:Name="AddinDataGrid"
                      ItemsSource="{Binding AddinCollectionView}"
                      Style="{StaticResource DataGridDefault}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      MouseDoubleClick="AddinDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <!-- 全选复选框列 -->
                    <DataGridTemplateColumn Width="50" Header="选择">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox Command="{Binding DataContext.SelectAllCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          HorizontalAlignment="Center" ToolTip="全选/取消全选"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="120" Binding="{Binding InstallLocation}" Header="安装位置" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="*" Header="Addin文件名" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AddinFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding FileFullPath}"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="*" Binding="{Binding Remark}" Header="Name" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="80" Header="启用">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <mah:ToggleSwitch IsOn="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  OffContent="" OnContent=""
                                                  Style="{StaticResource CenteredToggleSwitch}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="Auto" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                    <Button Content="打开" Style="{StaticResource RoundedButton}"
                                            Padding="10,5" Margin="0,0,6,0" FontSize="12"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="打开所在目录"/>
                                    <Button Content="删除" Style="{StaticResource DeleteButton}"
                                            Padding="10,5" FontSize="12"
                                            Command="{Binding DataContext.DeleteAddinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="删除插件"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <!-- 右键菜单 -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="查看详情" Click="ContextMenu_ViewDetails_Click">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="InformationOutline" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="打开目录" Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="FolderOutline" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="删除" Command="{Binding DeleteAddinCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="16" Height="16" Foreground="#E53935"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- 空数据提示 -->
            <ContentControl Template="{StaticResource EmptyDataTemplate}"
                           Visibility="{Binding HasItems, ElementName=AddinDataGrid, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.Gray10}" BorderBrush="{DynamicResource MahApps.Brushes.Border.NonActive}" BorderThickness="1"
                CornerRadius="4" Margin="0,10,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}">
                        <Run Text="总计:"/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource MahApps.Brushes.Accent}"/>
                        <Run Text="个插件"/>
                    </TextBlock>
                    <Separator Margin="15,0" Background="{DynamicResource MahApps.Brushes.Border.NonActive}" Width="1"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}">
                        <Run Text="已启用:"/>
                        <Run Text="{Binding EnabledCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#43A047"/>
                    </TextBlock>
                    <Separator Margin="15,0" Background="{DynamicResource MahApps.Brushes.Border.NonActive}" Width="1"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Text}">
                        <Run Text="已禁用:"/>
                        <Run Text="{Binding DisabledCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E53935"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MahApps.Brushes.Gray3}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Foreground="{DynamicResource MahApps.Brushes.Gray5}" VerticalAlignment="Center" FontSize="12">
                        <Run Text="更新于 "/>
                        <Run Text="{Binding LastUpdateTime, StringFormat='HH:mm:ss'}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
