<Window x:Class="AddinFileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AddinFileManager.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AddinFileManager"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Revit插件管理器" Width="1150" Height="700"
        WindowStartupLocation="CenterScreen" mc:Ignorable="d">
    <Window.Resources>
        <!-- 转换器 -->
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- 圆角按钮样式 -->
        <Style x:Key="RoundedButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 删除按钮样式 -->
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background" Value="#FFCCCCCC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE51400"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 版本列表项样式 -->
        <Style x:Key="VersionListItem" TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#BBDEFB"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#90CAF9"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 空数据提示模板 -->
        <ControlTemplate x:Key="EmptyDataTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0">
                <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                           HorizontalAlignment="Center" Foreground="#B0BEC5"/>
                <TextBlock Text="未找到插件" FontSize="18" Margin="0,15,0,0"
                           HorizontalAlignment="Center" Foreground="#78909C"/>
                <TextBlock Text="当前 Revit 版本目录下没有第三方插件" FontSize="13" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="#9E9E9E"/>
            </StackPanel>
        </ControlTemplate>

        <!-- ToggleSwitch 居中样式 -->
        <Style x:Key="CenteredToggleSwitch" TargetType="mah:ToggleSwitch" BasedOn="{StaticResource MahApps.Styles.ToggleSwitch}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 左侧版本列表区域 -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 设置按钮（齿轮图标+文字） -->
            <Button Grid.Row="0" Style="{StaticResource RoundedButton}"
                    Margin="0,0,0,15" Padding="12,8"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12 15.5A3.5 3.5 0 0 1 8.5 12A3.5 3.5 0 0 1 12 8.5a3.5 3.5 0 0 1 3.5 3.5a3.5 3.5 0 0 1-3.5 3.5m7.43-2.53c.04-.32.07-.64.07-.97c0-.33-.03-.66-.07-1l2.11-1.63c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.31-.61-.22l-2.49 1c-.52-.39-1.06-.73-1.69-.98l-.37-2.65A.506.506 0 0 0 14 2h-4c-.25 0-.46.18-.5.42l-.37 2.65c-.63.25-1.17.59-1.69.98l-2.49-1c-.22-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64L4.57 11c-.04.34-.07.67-.07 1c0 .33.03.65.07.97l-2.11 1.66c-.19.15-.25.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1.01c.52.4 1.06.74 1.69.99l.37 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.37-2.65c.63-.26 1.17-.59 1.69-.99l2.49 1.01c.22.08.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.66z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="设置" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 版本列表 -->
            <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding RevitVersionItems}"
                         SelectedItem="{Binding SelectedVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ItemContainerStyle="{StaticResource VersionListItem}"
                         BorderThickness="0"/>
            </Border>
        </Grid>

        <!-- 右侧顶部工具栏 -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 搜索框 -->
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     mah:TextBoxHelper.Watermark="搜索插件..."
                     mah:TextBoxHelper.ClearTextButton="True"
                     VerticalAlignment="Center"
                     Padding="8,6"/>

            <!-- 批量操作按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="批量启用" Margin="0,0,8,0" Padding="15,6"
                        Command="{Binding BatchEnableCommand}"/>
                <Button Content="批量禁用" Margin="0,0,8,0" Padding="15,6"
                        Command="{Binding BatchDisableCommand}"/>
                <Button Content="刷新" Padding="15,6"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 右侧 DataGrid 区域 -->
        <Grid Grid.Row="1" Grid.Column="1">
            <DataGrid x:Name="AddinDataGrid"
                      ItemsSource="{Binding FilteredAddinItems}"
                      Style="{StaticResource DataGridDefault}"
                      AlternatingRowBackground="#F5F5F5"
                      RowBackground="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0"
                      VerticalGridLinesBrush="Transparent">
                <DataGrid.Columns>
                    <!-- 全选复选框列 -->
                    <DataGridTemplateColumn Width="50" Header="选择">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="100" Binding="{Binding InstallLocation}" Header="安装位置" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="*" Header="Addin文件名" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AddinFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.ToolTip>
                                        <ToolTip Content="{Binding FileFullPath}"/>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Width="*" Binding="{Binding Remark}" Header="Name" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="80" Header="启用">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <mah:ToggleSwitch IsOn="{Binding IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  OffContent="" OnContent=""
                                                  Style="{StaticResource CenteredToggleSwitch}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="100" Header="打开目录">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="打开目录" Style="{StaticResource RoundedButton}"
                                        Width="70" Height="28"
                                        Command="{Binding OpenFolderCommand}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="80" Header="删除">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="删除" Style="{StaticResource DeleteButton}"
                                        Width="50" Height="28"
                                        Command="{Binding DeleteCommand}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 空数据提示 -->
            <ContentControl Template="{StaticResource EmptyDataTemplate}"
                           Visibility="{Binding HasItems, ElementName=AddinDataGrid, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="4" Margin="0,10,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center">
                    <Run Text="总计:" Foreground="#616161"/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1976D2"/>
                    <Run Text="个插件"/>
                </TextBlock>
                <Separator Margin="15,0" Background="#E0E0E0" Width="1"/>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="已启用:" Foreground="#616161"/>
                    <Run Text="{Binding EnabledCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#43A047"/>
                </TextBlock>
                <Separator Margin="15,0" Background="#E0E0E0" Width="1"/>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="已禁用:" Foreground="#616161"/>
                    <Run Text="{Binding DisabledCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#E53935"/>
                </TextBlock>
                <Separator Margin="15,0" Background="#E0E0E0" Width="1"
                           Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock VerticalAlignment="Center"
                           Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}">
                    <Run Text="筛选结果:" Foreground="#616161"/>
                    <Run Text="{Binding FilteredCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#FB8C00"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>